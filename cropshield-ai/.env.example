# CropShield AI Environment Configuration

# Provider Selection: groq (primary / default), alibaba, gemini, ollama
VISION_PROVIDER = groq

# Groq API Configuration (Primary)
GROQ_API_KEY = gsk_your_groq_api_key_here
VITE_GROQ_API_KEY = gsk_your_groq_api_key_here
GROQ_BASE_URL = https://api.groq.com/openai/v1
GROQ_MODEL = qwen/qwen3.8-27b

# Alibaba Cloud Model Studio Configuration (Alternative)
ALIBABA_API_KEY = 
ALIBABA_BASE_URL = https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL = qwen3.8-27b

# Google Gemini Configuration (Optional)
GEMINI_API_KEY = 
GEMINI_MODEL = gemini-1.5-flash
#SENTINEL
client_id = your_sentinel_client_id_here
client_secret = your_sentinel_client_secret_here